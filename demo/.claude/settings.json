{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Read|WebFetch|WebSearch|Bash|mcp__.*",
        "hooks": [{ "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR\"/../denetci/giris.py" }]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|WebFetch|mcp__.*",
        "hooks": [{ "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR\"/../denetci/cikis.py" }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR\"/../denetci/cikis.py" }]
      }
    ]
  }
}
